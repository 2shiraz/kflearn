{
  "name": "kflearn-osce-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:cvs": "node src/seed/seedCvs.js",
    "seed:endocrinology": "node src/seed/seedEndocrinology.js",
