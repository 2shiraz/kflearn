PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/phms
FRONTEND_URL=http://localhost:5173

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_EVAL_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EVAL_MODEL=gpt-5.6-luna

DEFAULT_AI_PROVIDER=groq
MAX_STUDENT_MESSAGE_TOKENS=160

# Required in production: random string, 32+ chars (e.g. `openssl rand -hex 32`).
# Rotating this logs out every active session.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=1d

# Optional: separate key used only to encrypt AI provider keys saved via the admin
# settings UI. Falls back to JWT_SECRET if unset. Set your own with `openssl rand -hex 32`
# so JWT rotation doesn't also break decryption of stored provider keys.
ENCRYPTION_KEY=

# "lax" works when frontend and backend share a registrable domain (incl. localhost
# dev across ports). Set to "none" only if they are on fully different domains —
# that also forces the Secure cookie flag on, so it requires HTTPS.
COOKIE_SAMESITE=lax
